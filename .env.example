# Copy to .env.local (npm run db:local writes one for you) and fill in.
# On Vercel, set these under Project Settings -> Environment Variables. Never commit real values (NF09).

# MySQL 8.0.16+ (Aiven/Railway; not TiDB). Aiven: add ?ssl-mode=REQUIRED (already in its Service URI).
DATABASE_URL=mysql://user:pass@host:3306/dental
# Optional: PEM of the DB's CA cert (Aiven "CA certificate") to verify TLS; '\n' escapes allowed.
DATABASE_CA_CERT=
# Integration tests only (defaults to DATABASE_URL with the database renamed to dental_test; must be local)
TEST_DATABASE_URL=

# openssl rand -base64 32
SESSION_SECRET=at-least-32-random-characters
CRON_SECRET=

# Gmail SMTP with an app password. Leave SMTP_USER/SMTP_PASS empty locally to log emails instead.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=yourclinic.demo@gmail.com
SMTP_PASS=16-character-app-password
MAIL_FROM="Sample Dental Clinic <yourclinic.demo@gmail.com>"

CLINIC_NAME="Sample Dental Clinic"
CLINIC_PHONE="0917 000 0000"
SLOT_INTERVAL_MINUTES=30
NO_SHOW_THRESHOLD=2

# Seed only (npm run db:reset): password for staff@clinic.test. Change it before seeding the public demo DB.
SEED_STAFF_PASSWORD=ClinicDemo2026!
