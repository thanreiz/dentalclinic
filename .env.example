# Copy to .env.local (npm run db:local writes one for you) and fill in.
# On Vercel, set these under Project Settings -> Environment Variables. Never commit real values (NF09).

# MySQL 8.0.16+ (Aiven/Railway; not TiDB). Aiven: add ?ssl-mode=REQUIRED (already in its Service URI).
DATABASE_URL=mysql://user:pass@host:3306/dental
# PEM of the DB's CA certificate, used to verify TLS ('\n' escapes allowed, one line is fine).
# REQUIRED in production for a non-local DB: the app refuses to connect without it (SECURITY-REVIEW M3).
# Aiven: service page -> Connection information -> CA certificate -> Download (see docs/DEPLOY.md).
DATABASE_CA_CERT=
# Integration tests only (defaults to DATABASE_URL with the database renamed to dental_test; must be local)
TEST_DATABASE_URL=

# openssl rand -base64 32  (both must be >= 32 characters; shorter values are refused)
SESSION_SECRET=
CRON_SECRET=

# Gmail SMTP with an app password. Leave SMTP_USER/SMTP_PASS empty locally to log emails instead.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=yourclinic.demo@gmail.com
SMTP_PASS=16-character-app-password
MAIL_FROM="G4 Dental Clinic <yourclinic.demo@gmail.com>"

CLINIC_NAME="G4 Dental Clinic"
CLINIC_PHONE="0917 000 0000"
SLOT_INTERVAL_MINUTES=30
NO_SHOW_THRESHOLD=2

# Abuse caps for the public POST /api/requests (SECURITY-REVIEW H1). Defaults shown; 0 disables a cap.
# Pending online requests (today or later) per contact number:
REQUEST_LIMIT_PER_CONTACT=3
# Online requests created clinic-wide in the last hour / last 24 hours:
REQUEST_LIMIT_PER_HOUR=60
REQUEST_LIMIT_PER_DAY=300
# Accepted requests per client IP per window (in-memory, per server instance; best effort):
REQUEST_LIMIT_PER_IP=5
REQUEST_LIMIT_IP_WINDOW_MINUTES=10

# Seed only (npm run db:reset): password for staff@clinic.test.
# Leave blank locally to use the local-only default (npm run db:local writes it into .env.local).
# REQUIRED for any non-local reset: at least 12 characters and not the default, or db:reset refuses.
SEED_STAFF_PASSWORD=
